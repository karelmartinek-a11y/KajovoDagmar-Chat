PUBLIC_DOMAIN=chat.hcasc.cz
ACME_EMAIL=provoz@example.invalid
HTTP_PORT=80
HTTPS_PORT=443
APP_IMAGE=registry.example.invalid/kajovodagmar@sha256:replace-with-release-digest
POSTGRES_PASSWORD=replace-with-random-database-password
PGBACKREST_REPO1_CIPHER_PASS=replace-with-random-backup-encryption-passphrase
KAJOVODAGMAR_ENVIRONMENT=production
KAJOVODAGMAR_PUBLIC_ORIGIN=https://chat.hcasc.cz
KAJOVODAGMAR_ROOT_ENCRYPTION_KEY=replace-with-output-of-make-generate-root-key
KAJOVODAGMAR_INITIALIZATION_SECRET_HASH=replace-with-initialization-secret-digest
KAJOVODAGMAR_SESSION_COOKIE_NAME=__Host-kajovodagmar_session
KAJOVODAGMAR_LOG_LEVEL=INFO
KAJOVODAGMAR_LOG_DIRECTORY=/opt/kajovodagmar/runtime/logs
KAJOVODAGMAR_STATIC_DIRECTORY=/opt/kajovodagmar/web/dist
KAJOVODAGMAR_OTLP_ENDPOINT=
KAJOVODAGMAR_TELEMETRY_SERVICE_NAME=kajovodagmar
