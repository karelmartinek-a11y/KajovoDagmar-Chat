#!/bin/bash
set -Eeuo pipefail
umask 027

readonly RELEASE_SHA=${1:-}
readonly ROOT=/srv/hcasc/kajovodagmar-chat
readonly REPOSITORY=$ROOT/repo
readonly RELEASES=$ROOT/releases
readonly SHARED=$ROOT/shared
readonly ENV_FILE=$SHARED/env/production.env
readonly GITHUB_KEY=$SHARED/secrets/github-readonly
readonly GITHUB_KNOWN_HOSTS=$SHARED/secrets/github-known-hosts
readonly VOICE_SERVICE_KEY_FILE=$SHARED/secrets/voice-service-api-key
readonly TOOLS=$SHARED/tools
readonly ACTIVE_SHA_FILE=$SHARED/data/active-release-sha
readonly PROJECT=kajovodagmar-chat
readonly DOMAIN=chat.hcasc.cz
readonly LOOPBACK_PORT=18180
readonly POSTGRES_IMAGE=kajovodagmar-chat-postgres:17-pgbackrest-2.59.0
readonly GIT_URL=git@github.com:karelmartinek-a11y/KajovoDagmar-Chat.git

ensure_voice_service_key() {
  install -d -o root -g root -m 0700 "$SHARED/secrets"
  if [[ ! -e $VOICE_SERVICE_KEY_FILE ]]; then
    local temporary
    temporary=$(mktemp "$SHARED/secrets/.voice-service-api-key.XXXXXX")
    trap 'rm -f -- "$temporary"' RETURN
    openssl rand -base64 48 | tr -d '\n' >"$temporary"
    chown root:root "$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$VOICE_SERVICE_KEY_FILE"
    trap - RETURN
  fi
  test -f "$VOICE_SERVICE_KEY_FILE"
  test "$(stat -c '%a' "$VOICE_SERVICE_KEY_FILE")" = 600
  test "$(stat -c '%U:%G' "$VOICE_SERVICE_KEY_FILE")" = root:root
  test "$(stat -c '%s' "$VOICE_SERVICE_KEY_FILE")" -ge 32
}

if [[ ! $RELEASE_SHA =~ ^[0-9a-f]{40}$ ]]; then
  echo "Deployment requires one exact 40-character lowercase commit SHA." >&2
  exit 64
fi

ensure_voice_service_key

deployment_password_b64=$(</dev/stdin)
if [[ -z $deployment_password_b64 || ! $deployment_password_b64 =~ ^[A-Za-z0-9+/]*={0,2}$ ]]; then
  echo "A base64-encoded production password is required on standard input." >&2
  exit 78
fi

exec 9>/run/lock/kajovodagmar-chat-deploy.lock
if ! flock -n 9; then
  echo "Another KájovoDagmar-Chat deployment is active." >&2
  exit 75
fi

for required in "$ENV_FILE" "$GITHUB_KEY" "$GITHUB_KNOWN_HOSTS"; do
  if [[ ! -f $required ]]; then
    echo "Required protected file is missing: $required" >&2
    exit 78
  fi
done

available_kb=$(df -Pk "$ROOT" | awk 'NR == 2 {print $4}')
if (( available_kb < 8 * 1024 * 1024 )); then
  echo "At least 8 GiB of free disk is required for a deployment." >&2
  exit 73
fi

export GIT_SSH_COMMAND="ssh -i $GITHUB_KEY -o IdentitiesOnly=yes -o UserKnownHostsFile=$GITHUB_KNOWN_HOSTS -o StrictHostKeyChecking=yes"
export PRODUCTION_ENV_FILE=$ENV_FILE
export SHARED_DATA_DIR=$SHARED/data
export BACKUP_REPOSITORY_DIR=$SHARED/backups/pgbackrest
export APP_LOOPBACK_PORT=$LOOPBACK_PORT
export POSTGRES_IMAGE
export RELEASE_SHA
export VOICE_SERVICE_KEY_FILE

previous_sha=
if [[ -f $ACTIVE_SHA_FILE ]]; then
  previous_sha=$(<"$ACTIVE_SHA_FILE")
fi

release=$RELEASES/$RELEASE_SHA
evidence=$SHARED/logs/releases/$RELEASE_SHA
app_image=kajovodagmar-chat:$RELEASE_SHA
deployment_succeeded=false
current_stage=initialization

compose_for() {
  local release_directory=$1
  local exact_sha=$2
  shift 2
  env \
    RELEASE_SHA="$exact_sha" \
    APP_IMAGE=kajovodagmar-chat:"$exact_sha" \
    docker compose \
      --project-name "$PROJECT" \
      --env-file "$ENV_FILE" \
      --file "$release_directory/deployment/compose.yaml" \
      --file "$release_directory/deployment/production/compose.yaml" \
      "$@"
}

restore_previous_release() {
  if [[ ! $previous_sha =~ ^[0-9a-f]{40}$ || $previous_sha == "$RELEASE_SHA" ]]; then
    return 1
  fi
  local previous_release=$RELEASES/$previous_sha
  if [[ ! -d $previous_release ]]; then
    return 1
  fi
  echo "Restoring previous application release $previous_sha." >&2
  compose_for "$previous_release" "$previous_sha" up -d --wait --no-build --remove-orphans
  curl --fail --silent --show-error --max-time 15 \
    "http://127.0.0.1:$LOOPBACK_PORT/api/v1/health/ready" >/dev/null
  ln -sfn "$previous_release" "$ROOT/current.rollback"
  mv -Tf "$ROOT/current.rollback" "$ROOT/current"
  printf '%s\n' "$previous_sha" >"$ACTIVE_SHA_FILE.tmp"
  mv -f "$ACTIVE_SHA_FILE.tmp" "$ACTIVE_SHA_FILE"
}

on_exit() {
  local status=$?
  if (( status != 0 )) && [[ $deployment_succeeded != true ]]; then
    echo "Deployment failed during stage: $current_stage" >&2
    if [[ -s $evidence/password-synchronization.json ]]; then
      jq -c '{synchronized, reason, message}' \
        "$evidence/password-synchronization.json" >&2 || true
    fi
    set +e
    restore_previous_release
    rollback_status=$?
    printf '{"event":"deployment.failed","sha":"%s","rollback_status":%d,"timestamp":"%s"}\n' \
      "$RELEASE_SHA" "$rollback_status" "$(date --iso-8601=seconds)" \
      >>"$SHARED/logs/deployment-audit.jsonl"
  fi
  exit "$status"
}
trap on_exit EXIT

mkdir -p "$RELEASES" "$evidence" "$TOOLS"

if [[ ! -f $REPOSITORY/HEAD ]]; then
  if [[ -d $REPOSITORY ]]; then
    rmdir "$REPOSITORY"
  fi
  git clone --mirror "$GIT_URL" "$REPOSITORY"
else
  git --git-dir="$REPOSITORY" remote set-url origin "$GIT_URL"
fi
git --git-dir="$REPOSITORY" fetch --prune origin \
  '+refs/heads/main:refs/remotes/origin/main'
git --git-dir="$REPOSITORY" cat-file -e "$RELEASE_SHA^{commit}"
git --git-dir="$REPOSITORY" merge-base --is-ancestor \
  "$RELEASE_SHA" refs/remotes/origin/main

if [[ ! -d $release ]]; then
  temporary_release=$RELEASES/.tmp-"$RELEASE_SHA"-$$
  mkdir "$temporary_release"
  git --git-dir="$REPOSITORY" archive "$RELEASE_SHA" | tar -x -C "$temporary_release"
  printf '%s\n' "$RELEASE_SHA" >"$temporary_release/.release-sha"
  mv "$temporary_release" "$release"
fi
test "$(<"$release/.release-sha")" = "$RELEASE_SHA"
test "$(git --git-dir="$REPOSITORY" rev-parse "$RELEASE_SHA^{commit}")" = "$RELEASE_SHA"

"$release/scripts/install_ci_security_tools.sh" "$TOOLS" >"$evidence/security-tools.txt"
export PATH=$TOOLS:$PATH

docker build --pull --tag "$app_image" \
  --file "$release/deployment/Dockerfile" "$release"
docker build --pull --tag "$POSTGRES_IMAGE" \
  --file "$release/deployment/Dockerfile.postgres" "$release"
docker image inspect "$app_image" --format '{{.Id}}' >"$evidence/image-id.txt"

syft dir:"$release/backend" --exclude './.venv/**' \
  -o cyclonedx-json="$evidence/sbom-backend-source.cdx.json"
syft dir:"$release/web" --exclude './node_modules/**' --exclude './dist/**' \
  -o cyclonedx-json="$evidence/sbom-frontend-source.cdx.json"
syft "$app_image" -o cyclonedx-json="$evidence/sbom-image.cdx.json"
vex_image=$(jq -er '.image | select(type == "string" and length > 0)' \
  "$release/security/vex-policy.json")
docker tag "$app_image" "$vex_image"
test "$(docker image inspect "$app_image" --format '{{.Id}}')" = \
  "$(docker image inspect "$vex_image" --format '{{.Id}}')"
grype "$vex_image" --vex "$release/security/vex.openvex.json" \
  -o json >"$evidence/grype-image.json"
docker run --rm \
  --user 0:0 \
  --volume "$release:/workspace:ro" \
  --volume "$evidence:/evidence:ro" \
  --entrypoint python \
  "$app_image" \
  /workspace/scripts/check_vulnerability_report.py \
  /evidence/grype-image.json \
  --vex /workspace/security/vex.openvex.json \
  --policy /workspace/security/vex-policy.json \
  >"$evidence/vulnerability-gate.txt"

compose_for "$release" "$RELEASE_SHA" up -d --wait --no-build db pgbackrest
compose_for "$release" "$RELEASE_SHA" exec -T --user postgres db \
  pgbackrest --stanza=kajovodagmar stanza-create
compose_for "$release" "$RELEASE_SHA" exec -T --user postgres db \
  pgbackrest --stanza=kajovodagmar --type=full backup
compose_for "$release" "$RELEASE_SHA" exec -T --user postgres db \
  pgbackrest --stanza=kajovodagmar check
compose_for "$release" "$RELEASE_SHA" exec -T --user postgres db \
  pgbackrest --stanza=kajovodagmar info --output=json \
  >"$evidence/pre-migration-backup.json"

current_stage=database_migration
compose_for "$release" "$RELEASE_SHA" run --rm --no-deps web alembic upgrade head
current_stage=application_start
compose_for "$release" "$RELEASE_SHA" up -d --wait --no-build --remove-orphans
current_stage=instance_bootstrap
compose_for "$release" "$RELEASE_SHA" exec -T web kajovodagmar bootstrap-instance \
  >"$evidence/bootstrap-instance.json"
current_stage=password_synchronization
printf '%s' "$deployment_password_b64" | base64 --decode | \
  compose_for "$release" "$RELEASE_SHA" exec -T web \
    kajovodagmar synchronize-deployment-password \
    >"$evidence/password-synchronization.json"
jq -e '.synchronized == true' "$evidence/password-synchronization.json" >/dev/null

current_stage=internal_health
curl --fail --silent --show-error --max-time 15 \
  --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 5 \
  "http://127.0.0.1:$LOOPBACK_PORT/api/v1/health/ready" \
  >"$evidence/internal-health.json"
current_stage=public_health
curl --fail --silent --show-error --max-time 20 \
  --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 5 \
  "https://$DOMAIN/api/v1/health/ready" >"$evidence/public-health.json"
current_stage=public_ui
curl --fail --silent --show-error --max-time 20 "https://$DOMAIN/" |
  grep -F "KájovoDagmar" >"$evidence/ui-branding.txt"
current_stage=unrelated_service_health
curl --fail --silent --show-error --max-time 20 \
  https://dagmar.hcasc.cz/ >/dev/null

ln -sfn "$release" "$ROOT/current.new"
mv -Tf "$ROOT/current.new" "$ROOT/current"
printf '%s\n' "$RELEASE_SHA" >"$ACTIVE_SHA_FILE.tmp"
mv -f "$ACTIVE_SHA_FILE.tmp" "$ACTIVE_SHA_FILE"
current_stage=voice_provider_probe
compose_for "$release" "$RELEASE_SHA" exec -T web kajovodagmar diagnostics-voice-live-probe \
  >"$evidence/voice-live-probe.json"
current_stage=deploy_script_install
install -o root -g root -m 0750 \
  "$release/deployment/production/deploy-kajovodagmar-chat" \
  /usr/local/sbin/deploy-kajovodagmar-chat.next
mv -f /usr/local/sbin/deploy-kajovodagmar-chat.next \
  /usr/local/sbin/deploy-kajovodagmar-chat
install -o root -g root -m 0750 \
  "$release/scripts/production_voice_forensics.sh" \
  /usr/local/sbin/kajovodagmar-voice-forensics.next
mv -f /usr/local/sbin/kajovodagmar-voice-forensics.next \
  /usr/local/sbin/kajovodagmar-voice-forensics
install -o root -g root -m 0750 \
  "$release/scripts/production_voice_service_key.sh" \
  /usr/local/sbin/kajovodagmar-voice-service-key.next
mv -f /usr/local/sbin/kajovodagmar-voice-service-key.next \
  /usr/local/sbin/kajovodagmar-voice-service-key
printf '{"event":"deployment.succeeded","sha":"%s","previous_sha":"%s","timestamp":"%s"}\n' \
  "$RELEASE_SHA" "$previous_sha" "$(date --iso-8601=seconds)" \
  >>"$SHARED/logs/deployment-audit.jsonl"
deployment_succeeded=true
trap - EXIT
echo "KájovoDagmar-Chat deployment succeeded for $RELEASE_SHA."
