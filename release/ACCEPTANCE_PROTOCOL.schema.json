{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://chat.hcasc.cz/schemas/acceptance-protocol-v1.json",
  "type":"object",
  "required":["candidate","ssot_sha256","commit","environment","results","decision","integrity_sha256"],
  "properties":{
    "candidate":{"type":"string"},"ssot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "commit":{"type":"string"},"environment":{"type":"object"},"results":{"type":"array"},
    "known_defects":{"type":"array"},"exceptions":{"type":"array"},
    "decision":{"enum":["accepted","not_accepted"]},"integrity_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },"additionalProperties":false
}
